<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>insert title</title>
    <style>
    body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f4f4f9;
    margin: 0;
    font-family: sans-serif;

}
    
.calculator {
    width: 400px;
    margin: 50px auto;
    box-shadow: 0px 15px 35px rgba(0, 0, 0, 0.3);
    border-radius: 20px;
    padding: 25px;
    background-color: #333;

}

#display {
    width: 100%;
    height: 80px;
    margin-bottom: 20px;
    text-align: right;
    font-size: 20px;
    box-sizing: border-box;
    background-color: #eee;
    border: none;
    border-radius: 10px;
    padding: 10px;

}

        .buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;

        }

        button {
           height: 75px;
           font-size: 1.5rem;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: background 0.2s;

        }
        button:hover { background-color: #ddd; }
        .operator { background-color: #ff9500; color: white; }
        .clear { background-color: #ff3b30; color: white; }</style>
    <link rel="stylesheet" href="https://os.ivabgaming.com/root.css">
</head>
<body>
    <div class="calculator">
        <input type="text" id="display" disabled>
        <div class="buttons">
            <button class="clear" onclick="clearDisplay()">C</button>
            <button onclick="appendToDisplay('/')">/</button>
            <button onclick="appendToDisplay('*')">*</button>            
            <button class="operator" onclick="calculateResult()">=</button>

            <button onclick="appendToDisplay('7')">7</button>
            <button onclick="appendToDisplay('8')">8</button>
            <button onclick="appendToDisplay('9')">9</button>
            <button class="operator" onclick="appendToDisplay('-')">-</button>

            <button onclick="appendToDisplay('4')">4</button>
            <button onclick="appendToDisplay('5')">5</button>
            <button onclick="appendToDisplay('6')">6</button>
            <button class="operator" onclick="appendToDisplay('+')">+</button>

            <button onclick="appendToDisplay('1')">1</button>
            <button onclick="appendToDisplay('2')">2</button>
            <button onclick="appendToDisplay('3')">3</button>
            <button class="operator" onclick="calculate()">=</button>

            <button style="grid-column: span 2;" onclick="appendToDisplay('0')">0</button>
            <button onclick="appendToDisplay('.')">.</button>
            <button onclick="exit()" class="operator">␛</button>
        </div>
    </div>
    </div>

    <script>
        const display = document.getElementById('display');

        function appendToDisplay(input) { display.value += input; }
        function clearDisplay() { display.value = ""; }
        function backspace () { display.value = display.value.slice(0, -1); }
        function calculateResult() {
            try {
                display.value = eval(display.value);
            } catch (error) {
                display.value = "Error";
            }
        }

        document.addEventListener('keydown', (event) => {
            const key = event.key;
            if ((event.key >= '0' && key <= '9') || ['+', '-', '*', '/', '.'].includes(event.key)) {
                appendToDisplay(event.key);
            } else if (event.key === 'Enter') {
                calculateResult();
            } else if (event.key === 'Backspace') {
                backspace();
            } else if (event.key === 'Escape') {
                clearDisplay();
            }
        });

        function exit() {
            window.location.href = 'http://localhost:8080/LocusOS/index.html';
        }
    </script>

    <script src="http://localhost:8080/cursor.js"></script>
</body>
</html>