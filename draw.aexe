<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Draw // AlexOS</title>
<style>
  :root {
    --cyan: #00f5ff;
    --pink: #ff006e;
    --yellow: #ffcc00;
    --green: #39ff14;
    --dark: #050510;
    --mid: #0a0a20;
    --text: #e0e8ff;
    --sub: rgba(224,232,255,0.45);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; cursor: none !important; }

  body {
    background: var(--dark);
    color: var(--text);
    font-family: 'Share Tech Mono', 'Courier New', monospace;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(0,245,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,245,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  /* Toolbar */
  #toolbar {
    position: relative; z-index: 10;
    display: flex; align-items: center; gap: 8px;
    padding: 6px 12px;
    background: rgba(5,5,16,0.97);
    border-bottom: 1px solid rgba(0,245,255,0.2);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .tool-label {
    font-size: 0.55rem;
    letter-spacing: 3px;
    color: var(--sub);
    margin-right: 2px;
  }

  .tool-btn {
    font-family: 'Orbitron', 'Share Tech Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 2px;
    padding: 5px 10px;
    border: 1px solid rgba(255,255,255,0.15);
    background: transparent;
    color: rgba(255,255,255,0.35);
    cursor: pointer !important;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .tool-btn:hover, .tool-btn.active {
    border-color: var(--cyan);
    color: var(--cyan);
    box-shadow: 0 0 8px rgba(0,245,255,0.2);
  }
  .tool-btn.active {
    background: rgba(0,245,255,0.08);
  }

  .sep {
    width: 1px;
    height: 24px;
    background: rgba(255,255,255,0.1);
    flex-shrink: 0;
  }

  /* Color swatches */
  #colors {
    display: flex; gap: 4px; align-items: center;
  }
  .swatch {
    width: 18px; height: 18px;
    border: 1px solid rgba(255,255,255,0.2);
    cursor: pointer !important;
    transition: transform 0.1s, box-shadow 0.1s;
    flex-shrink: 0;
  }
  .swatch:hover { transform: scale(1.2); }
  .swatch.active {
    border: 2px solid #fff;
    box-shadow: 0 0 8px currentColor;
    transform: scale(1.15);
  }

  /* Custom color */
  #custom-color {
    width: 18px; height: 18px;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 0;
    cursor: pointer !important;
    background: none;
  }

  /* Size slider */
  #size-wrap {
    display: flex; align-items: center; gap: 6px;
  }
  #size-slider {
    -webkit-appearance: none;
    width: 80px; height: 3px;
    background: rgba(0,245,255,0.3);
    outline: none;
    cursor: pointer !important;
  }
  #size-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
    cursor: pointer !important;
  }
  #size-val {
    font-size: 0.6rem;
    color: var(--cyan);
    min-width: 20px;
  }

  /* Opacity slider */
  #opacity-wrap {
    display: flex; align-items: center; gap: 6px;
  }
  #opacity-slider {
    -webkit-appearance: none;
    width: 60px; height: 3px;
    background: rgba(255,0,110,0.3);
    outline: none;
    cursor: pointer !important;
  }
  #opacity-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 6px var(--pink);
    cursor: pointer !important;
  }

  /* Action buttons */
  .action-btn {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 2px;
    padding: 5px 10px;
    border: 1px solid rgba(255,0,110,0.3);
    background: transparent;
    color: var(--pink);
    cursor: pointer !important;
    transition: all 0.15s;
  }
  .action-btn:hover {
    background: var(--pink);
    color: var(--dark);
  }
  .save-btn {
    border-color: rgba(57,255,20,0.3);
    color: var(--green);
  }
  .save-btn:hover {
    background: var(--green);
    color: var(--dark);
  }

  /* Canvas area */
  #canvas-wrap {
    position: relative;
    flex: 1;
    overflow: hidden;
    z-index: 1;
  }

  #drawing-canvas {
    display: block;
    cursor: none !important;
    background: #08081a;
  }

  /* Status bar */
  #statusbar {
    position: relative; z-index: 10;
    display: flex; align-items: center; gap: 16px;
    padding: 4px 12px;
    background: rgba(5,5,16,0.97);
    border-top: 1px solid rgba(0,245,255,0.1);
    font-size: 0.55rem;
    letter-spacing: 2px;
    color: var(--sub);
    flex-shrink: 0;
  }
  #statusbar span { color: var(--cyan); }

  /* Custom cursor */
  #cursor { position: fixed; pointer-events: none; z-index: 9999; top: 0; left: 0; }
  #cursor-dot {
    width: 6px; height: 6px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyan), 0 0 20px var(--cyan);
    position: absolute;
    transform: translate(-50%, -50%);
  }
  #cursor-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(0,245,255,0.5);
    transform: translate(-50%, -50%);
    transition: width 0.1s, height 0.1s;
    pointer-events: none;
  }
</style>
</head>
<body>

<!-- Toolbar -->
<div id="toolbar">
  <span class="tool-label">TOOL //</span>
  <button class="tool-btn active" id="btn-pen" onclick="setTool('pen')">✏ PEN</button>
  <button class="tool-btn" id="btn-brush" onclick="setTool('brush')">◉ BRUSH</button>
  <button class="tool-btn" id="btn-line" onclick="setTool('line')">╱ LINE</button>
  <button class="tool-btn" id="btn-rect" onclick="setTool('rect')">▭ RECT</button>
  <button class="tool-btn" id="btn-circle" onclick="setTool('circle')">○ CIRCLE</button>
  <button class="tool-btn" id="btn-fill" onclick="setTool('fill')">▓ FILL</button>
  <button class="tool-btn" id="btn-eraser" onclick="setTool('eraser')">◻ ERASE</button>

  <div class="sep"></div>

  <span class="tool-label">COLOR //</span>
  <div id="colors">
    <div class="swatch active" style="background:#00f5ff" data-color="#00f5ff" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#ff006e" data-color="#ff006e" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#ffcc00" data-color="#ffcc00" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#39ff14" data-color="#39ff14" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#ffffff" data-color="#ffffff" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#ff4400" data-color="#ff4400" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#aa00ff" data-color="#aa00ff" onclick="setColor(this)"></div>
    <div class="swatch" style="background:#0044ff" data-color="#0044ff" onclick="setColor(this)"></div>
    <input type="color" id="custom-color" value="#00f5ff" title="Custom color" onchange="setCustomColor(this.value)">
  </div>

  <div class="sep"></div>

  <div id="size-wrap">
    <span class="tool-label">SIZE //</span>
    <input type="range" id="size-slider" min="1" max="60" value="4" oninput="setSize(this.value)">
    <span id="size-val">4</span>
  </div>

  <div class="sep"></div>

  <div id="opacity-wrap">
    <span class="tool-label">OPACITY //</span>
    <input type="range" id="opacity-slider" min="0.05" max="1" step="0.05" value="1" oninput="setOpacity(this.value)">
  </div>

  <div class="sep"></div>

  <button class="action-btn" onclick="undo()">↩ UNDO</button>
  <button class="action-btn" onclick="clearCanvas()">✕ CLEAR</button>
  <button class="action-btn save-btn" onclick="saveCanvas()">↓ SAVE</button>
</div>

<!-- Canvas -->
<div id="canvas-wrap">
  <canvas id="drawing-canvas"></canvas>
</div>

<!-- Status bar -->
<div id="statusbar">
  TOOL: <span id="stat-tool">PEN</span>
  &nbsp;|&nbsp;
  COLOR: <span id="stat-color">■ #00f5ff</span>
  &nbsp;|&nbsp;
  SIZE: <span id="stat-size">4px</span>
  &nbsp;|&nbsp;
  POS: <span id="stat-pos">0, 0</span>
</div>

<!-- Custom cursor -->
<div id="cursor">
  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>
</div>

<script>
  // ── Cursor ───────────────────────────────────────────────
  const cursorEl = document.getElementById('cursor');
  const dot = document.getElementById('cursor-dot');
  const ring = document.getElementById('cursor-ring');
  let mx = 0, my = 0;
  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    cursorEl.style.left = mx + 'px';
    cursorEl.style.top  = my + 'px';
    document.getElementById('stat-pos').textContent = mx + ', ' + my;
  });

  // ── Canvas setup ─────────────────────────────────────────
  const canvas = document.getElementById('drawing-canvas');
  const ctx = canvas.getContext('2d');
  const wrap = document.getElementById('canvas-wrap');

  function resizeCanvas() {
    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    canvas.width  = wrap.clientWidth;
    canvas.height = wrap.clientHeight;
    ctx.fillStyle = '#08081a';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.putImageData(imageData, 0, 0);
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  // ── State ────────────────────────────────────────────────
  let tool    = 'pen';
  let color   = '#00f5ff';
  let size    = 4;
  let opacity = 1;
  let drawing = false;
  let lastX   = 0, lastY  = 0;
  let startX  = 0, startY = 0;
  let history = [];
  let snapshot = null;

  function saveHistory() {
    history.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
    if (history.length > 40) history.shift();
  }

  function setTool(t) {
    tool = t;
    document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-' + t).classList.add('active');
    document.getElementById('stat-tool').textContent = t.toUpperCase();
  }

  function setColor(el) {
    color = el.dataset.color;
    document.querySelectorAll('.swatch').forEach(s => s.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('stat-color').textContent = '■ ' + color;
    dot.style.background = color;
    dot.style.boxShadow = `0 0 8px ${color}, 0 0 20px ${color}`;
    ring.style.borderColor = color;
  }

  function setCustomColor(val) {
    color = val;
    document.querySelectorAll('.swatch').forEach(s => s.classList.remove('active'));
    document.getElementById('stat-color').textContent = '■ ' + color;
    dot.style.background = color;
    dot.style.boxShadow = `0 0 8px ${color}, 0 0 20px ${color}`;
    ring.style.borderColor = color;
  }

  function setSize(val) {
    size = parseInt(val);
    document.getElementById('size-val').textContent = val;
    document.getElementById('stat-size').textContent = val + 'px';
    ring.style.width  = (size + 8) + 'px';
    ring.style.height = (size + 8) + 'px';
  }

  function setOpacity(val) {
    opacity = parseFloat(val);
  }

  function undo() {
    if (history.length === 0) return;
    ctx.putImageData(history.pop(), 0, 0);
  }

  function clearCanvas() {
    saveHistory();
    ctx.fillStyle = '#08081a';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  function saveCanvas() {
    const a = document.createElement('a');
    a.download = 'alexos-drawing.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  }

  // ── Flood fill ───────────────────────────────────────────
  function hexToRgb(hex) {
    const r = parseInt(hex.slice(1,3),16);
    const g = parseInt(hex.slice(3,5),16);
    const b = parseInt(hex.slice(5,7),16);
    return [r,g,b,255];
  }

  function floodFill(sx, sy, fillColor) {
    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const data = imgData.data;
    const w = canvas.width;
    const idx = (sy * w + sx) * 4;
    const target = [data[idx], data[idx+1], data[idx+2], data[idx+3]];
    const fill = hexToRgb(fillColor);
    if (target.every((v,i) => v === fill[i])) return;
    const stack = [[sx, sy]];
    while (stack.length) {
      const [x, y] = stack.pop();
      if (x < 0 || x >= w || y < 0 || y >= canvas.height) continue;
      const i = (y * w + x) * 4;
      if (data[i]!==target[0]||data[i+1]!==target[1]||data[i+2]!==target[2]||data[i+3]!==target[3]) continue;
      data[i]=fill[0]; data[i+1]=fill[1]; data[i+2]=fill[2]; data[i+3]=fill[3];
      stack.push([x+1,y],[x-1,y],[x,y+1],[x,y-1]);
    }
    ctx.putImageData(imgData, 0, 0);
  }

  // ── Drawing ──────────────────────────────────────────────
  function getPos(e) {
    const r = canvas.getBoundingClientRect();
    if (e.touches) return [e.touches[0].clientX - r.left, e.touches[0].clientY - r.top];
    return [e.clientX - r.left, e.clientY - r.top];
  }

  function applyStyle(erase) {
    ctx.globalAlpha = erase ? 1 : opacity;
    ctx.strokeStyle = erase ? '#08081a' : color;
    ctx.fillStyle   = erase ? '#08081a' : color;
    ctx.lineWidth   = size;
    ctx.lineCap     = 'round';
    ctx.lineJoin    = 'round';
    if (tool === 'brush') {
      ctx.shadowColor = color;
      ctx.shadowBlur  = size * 1.5;
    } else {
      ctx.shadowBlur = 0;
    }
  }

  canvas.addEventListener('mousedown', e => {
    const [x, y] = getPos(e);
    if (tool === 'fill') {
      saveHistory();
      floodFill(Math.floor(x), Math.floor(y), color);
      return;
    }
    saveHistory();
    drawing = true;
    lastX = startX = x;
    lastY = startY = y;
    if (tool === 'pen' || tool === 'brush' || tool === 'eraser') {
      applyStyle(tool === 'eraser');
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x + 0.1, y + 0.1);
      ctx.stroke();
    }
    if (tool === 'line' || tool === 'rect' || tool === 'circle') {
      snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);
    }
  });

  canvas.addEventListener('mousemove', e => {
    const [x, y] = getPos(e);
    // Update cursor ring size
    ring.style.width  = (size + 8) + 'px';
    ring.style.height = (size + 8) + 'px';

    if (!drawing) return;
    applyStyle(tool === 'eraser');

    if (tool === 'pen' || tool === 'brush' || tool === 'eraser') {
      ctx.beginPath();
      ctx.moveTo(lastX, lastY);
      ctx.lineTo(x, y);
      ctx.stroke();
      lastX = x; lastY = y;
    }

    if (tool === 'line') {
      ctx.putImageData(snapshot, 0, 0);
      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.lineTo(x, y);
      ctx.stroke();
    }

    if (tool === 'rect') {
      ctx.putImageData(snapshot, 0, 0);
      ctx.beginPath();
      ctx.strokeRect(startX, startY, x - startX, y - startY);
    }

    if (tool === 'circle') {
      ctx.putImageData(snapshot, 0, 0);
      const rx = Math.abs(x - startX) / 2;
      const ry = Math.abs(y - startY) / 2;
      const cx = startX + (x - startX) / 2;
      const cy = startY + (y - startY) / 2;
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
      ctx.stroke();
    }
  });

  canvas.addEventListener('mouseup',   () => { drawing = false; snapshot = null; ctx.shadowBlur = 0; });
  canvas.addEventListener('mouseleave',() => { drawing = false; snapshot = null; ctx.shadowBlur = 0; });

  // Init ring size
  setSize(4);
</script>
</body>
</html>
